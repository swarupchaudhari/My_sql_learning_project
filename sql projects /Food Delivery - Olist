 Food Delivery / Olist

This is your best JOIN project.

Main tables:

orders
customers
order_items
products
sellers
payments
reviews

Q1. What is the average delivery time by state?

SELECT
c.customer_state,

ROUND(
    AVG(
        EXTRACT(
            EPOCH FROM
            (o.order_delivered_customer_date
             - o.order_purchase_timestamp)
        ) / 86400
    ),
    2
) AS avg_delivery_days

FROM orders o

JOIN customers c
ON o.customer_id = c.customer_id

WHERE o.order_delivered_customer_date IS NOT NULL

GROUP BY c.customer_state

ORDER BY avg_delivery_days DESC;

Q2. Which product categories generate the most revenue?

SELECT
p.product_category_name,

ROUND(
    SUM(oi.price),
    2
) AS revenue

FROM order_items oi

JOIN products p
ON oi.product_id = p.product_id

GROUP BY p.product_category_name

ORDER BY revenue DESC
LIMIT 10;

Q3. Find late-delivered orders.

SELECT
order_id,
order_purchase_timestamp,
order_estimated_delivery_date,
order_delivered_customer_date

FROM orders

WHERE order_delivered_customer_date
> order_estimated_delivery_date

ORDER BY order_delivered_customer_date DESC;

Q4. Calculate late-delivery percentage.

SELECT
ROUND(
SUM(
CASE
WHEN order_delivered_customer_date
> order_estimated_delivery_date
THEN 1
ELSE 0
END
) * 100.0
/ COUNT(*),
2
) AS late_delivery_percentage

FROM orders

WHERE order_delivered_customer_date IS NOT NULL;

Q5. Which sellers have more than 50 orders?

SELECT
seller_id,
COUNT(DISTINCT order_id) AS total_orders

FROM order_items

GROUP BY seller_id

HAVING COUNT(DISTINCT order_id) > 50

ORDER BY total_orders DESC;

Q6. Which sellers have the highest average review score?

SELECT
oi.seller_id,

COUNT(DISTINCT oi.order_id) AS total_orders,

ROUND(AVG(r.review_score), 2) AS avg_review

FROM order_items oi

JOIN order_reviews r
ON oi.order_id = r.order_id

GROUP BY oi.seller_id

HAVING COUNT(DISTINCT oi.order_id) > 50

ORDER BY avg_review DESC;

Q7. Calculate repeat customers.

SELECT
customer_id,
COUNT(DISTINCT order_id) AS order_count

FROM orders

GROUP BY customer_id

HAVING COUNT(DISTINCT order_id) > 1

ORDER BY order_count DESC;

Q8. Calculate repeat purchase rate.

WITH customer_orders AS (
SELECT
customer_id,
COUNT(DISTINCT order_id) AS order_count
FROM orders
GROUP BY customer_id
)

SELECT
ROUND(
SUM(
CASE
WHEN order_count > 1 THEN 1
ELSE 0
END
) * 100.0 / COUNT(*),
2
) AS repeat_customer_rate

FROM customer_orders;

Q9. Create a seller scorecard.

This is one of the strongest portfolio queries.

WITH seller_revenue AS (
SELECT
seller_id,
SUM(price + freight_value) AS revenue,
COUNT(DISTINCT order_id) AS order_volume
FROM order_items
GROUP BY seller_id
),

seller_reviews AS (
SELECT
oi.seller_id,
AVG(r.review_score) AS avg_review
FROM order_items oi
JOIN order_reviews r
ON oi.order_id = r.order_id
GROUP BY oi.seller_id
),

seller_delivery AS (
SELECT
oi.seller_id,

    AVG(
        CASE
            WHEN o.order_delivered_customer_date
                 <= o.order_estimated_delivery_date
            THEN 1.0
            ELSE 0.0
        END
    ) * 100 AS on_time_rate

FROM order_items oi

JOIN orders o
    ON oi.order_id = o.order_id

WHERE o.order_delivered_customer_date IS NOT NULL

GROUP BY oi.seller_id

)

SELECT
sr.seller_id,
ROUND(sr.revenue, 2) AS revenue,
sr.order_volume,
ROUND(srv.avg_review, 2) AS avg_review,
ROUND(sd.on_time_rate, 2) AS on_time_rate,

RANK() OVER (
    ORDER BY sr.revenue DESC
) AS revenue_rank

FROM seller_revenue sr

LEFT JOIN seller_reviews srv
ON sr.seller_id = srv.seller_id

LEFT JOIN seller_delivery sd
ON sr.seller_id = sd.seller_id

ORDER BY revenue_rank;
